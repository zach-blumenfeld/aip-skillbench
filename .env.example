# aip-skillbench — environment template
# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# Only the keys you actually use need values. Empty / commented lines are fine.

# ─── Model API keys ────────────────────────────────────────────────────────

# Required for any Anthropic-model eval (claude-haiku-4-5, claude-sonnet-4-6,
# claude-opus-4-7) and for `aip-skillbench convert` (which shells to Claude Code).
ANTHROPIC_API_KEY=

# Required for any OpenAI-model eval (gpt-5.2-codex via codex-acp agent).
# OPENAI_API_KEY=

# Required for any Google-model eval (gemini-3-flash-preview, gemini-3-pro-preview).
# GEMINI_API_KEY=

# ─── Sandbox backends ──────────────────────────────────────────────────────

# Required only if you pass `--sandbox daytona` to `aip-skillbench eval`.
# Get a token at app.daytona.io → API Keys.
# DAYTONA_API_KEY=

# Required only if you pass `--sandbox modal`. `modal token new` writes its
# own ~/.modal.toml; this var is rarely needed unless overriding.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ─── Task-specific credentials (per-task, optional) ────────────────────────
# Some SkillsBench tasks need third-party API keys (e.g. citation-check needs
# Google Scholar / Semantic Scholar). Add as needed for tasks you actually run.
# SEMANTIC_SCHOLAR_API_KEY=
# AZURE_SUBSCRIPTION_ID=
