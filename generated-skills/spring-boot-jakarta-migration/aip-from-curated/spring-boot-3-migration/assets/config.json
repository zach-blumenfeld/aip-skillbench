{
  "target_boot_version": "3.2.0",
  "target_java_version": "21",
  "min_java_version": 17,
  "jjwt_version": "0.12.3",
  "skip_dirs": ["target", "build", ".git", ".idea", ".gradle", ".mvn", "node_modules", "out", "bin", ".vscode"],
  "remove_dependencies": [
    {"groupId": "javax.xml.bind", "artifactId": "*", "why": "Old Java EE JAXB API; conflicts with jakarta.xml.bind in Boot 3"},
    {"groupId": "com.sun.xml.bind", "artifactId": "jaxb-impl", "why": "Old JAXB implementation"},
    {"groupId": "com.sun.xml.bind", "artifactId": "jaxb-core", "why": "Old JAXB implementation"},
    {"groupId": "javax.activation", "artifactId": "activation", "why": "Old Java Activation"},
    {"groupId": "javax.activation", "artifactId": "javax.activation-api", "why": "Old Java Activation"}
  ],
  "jakarta_xml_bind_dependencies": [
    {"groupId": "jakarta.xml.bind", "artifactId": "jakarta.xml.bind-api"},
    {"groupId": "org.glassfish.jaxb", "artifactId": "jaxb-runtime"}
  ],
  "javax_artifact_replacements": {
    "javax.servlet:javax.servlet-api": "Remove (embedded Tomcat provides it) or use jakarta.servlet:jakarta.servlet-api without a version.",
    "javax.servlet:servlet-api": "Remove (embedded Tomcat provides it) or use jakarta.servlet:jakarta.servlet-api without a version.",
    "javax.validation:validation-api": "Use spring-boot-starter-validation (jakarta.validation) instead.",
    "javax.persistence:javax.persistence-api": "Remove; spring-boot-starter-data-jpa brings jakarta.persistence-api.",
    "javax.persistence:persistence-api": "Remove; spring-boot-starter-data-jpa brings jakarta.persistence-api.",
    "javax.annotation:javax.annotation-api": "Use jakarta.annotation:jakarta.annotation-api without a version.",
    "javax.transaction:javax.transaction-api": "Use jakarta.transaction:jakarta.transaction-api without a version.",
    "javax.inject:javax.inject": "Use jakarta.inject:jakarta.inject-api and jakarta.inject imports.",
    "javax.mail:mail": "Use spring-boot-starter-mail (jakarta.mail).",
    "com.sun.mail:javax.mail": "Use spring-boot-starter-mail (jakarta.mail).",
    "org.hibernate:hibernate-validator": "Use spring-boot-starter-validation (org.hibernate.validator group, Jakarta Validation).",
    "io.springfox:springfox-boot-starter": "Springfox does not support Boot 3; use org.springdoc:springdoc-openapi-starter-webmvc-ui 2.x.",
    "io.springfox:springfox-swagger2": "Springfox does not support Boot 3; use org.springdoc:springdoc-openapi-starter-webmvc-ui 2.x.",
    "io.springfox:springfox-swagger-ui": "Springfox does not support Boot 3; use org.springdoc:springdoc-openapi-starter-webmvc-ui 2.x.",
    "org.springdoc:springdoc-openapi-ui": "springdoc 1.x is Boot 2 only; use org.springdoc:springdoc-openapi-starter-webmvc-ui 2.x."
  },
  "javax_auto_packages": [
    "persistence", "validation", "servlet", "transaction", "ws.rs", "mail", "jms", "xml.bind"
  ],
  "javax_annotation_auto_classes": [
    "PostConstruct", "PreDestroy", "Resource", "Resources", "Priority", "security"
  ],
  "javax_manual_packages": [
    "inject", "websocket", "ejb", "enterprise", "faces", "json", "xml.ws", "xml.soap", "activation", "el", "security.enterprise", "batch", "interceptor", "decorator"
  ]
}
